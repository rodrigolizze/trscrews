# TR Screws - Variáveis de ambiente
# Copie para .env e preencha os valores (nunca commite .env)

# Stripe (obrigatório para pagamentos)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SIGNING_SECRET=

# Cloudinary (imagens em produção)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin (área /admin)
ADMIN_USER=admin
ADMIN_PASSWORD=

# App (produção - host para e-mails e URLs)
APP_HOST=

# SMTP (produção - envio de e-mails)
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=

# Frete (opcional - defaults em config/initializers/shipping.rb)
# SHIPPING_FREE_LIMIT=150
# SHIPPING_FEE_SUDESTE=20
# SHIPPING_FEE_SUL=25
# etc.
