<!DOCTYPE html>
<html>
  <head>
    <title>TR AutoFix</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <!-- // SEO meta (title, description, OG/Twitter) -->
    <%= render_basic_meta_tags %>

    <!-- Canonical URL -->
    <%= render_canonical_tag %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google Font: Aldrich -->
    <%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Aldrich&display=swap", rel: "stylesheet" %>
    <!-- Google Fonts: Anton + Inter (redesign, direção D) -->
    <%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap", rel: "stylesheet" %>

    <!-- Bootstrap CSS -->
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css", crossorigin: "anonymous" %>

    <!-- Bootstrap Icons -->
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css", rel: "stylesheet" %>

    <!-- Your custom SCSS -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <!-- Bootstrap JS Bundle (defer = load after page) -->
    <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js", crossorigin: "anonymous", defer: true %>

    <!-- Rails Import Maps (required) -->
    <%= javascript_importmap_tags %>

    <!-- AOS CSS -->
    <%= stylesheet_link_tag "https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" %>
    <%= yield :head %>
  </head>
  <body>
    <%= render "shared/navbar" %>
    <%= render "shared/flash" %>
    <%# // Tema escuro (direção D) para todas as páginas da loja: data-bs-theme="dark"
        // faz o Bootstrap 5.3 pintar cards, formulários e tabelas no modo escuro, e
        // .theme-d (components/_theme.scss) ajusta para a paleta da marca.
        // O /admin fica de fora de propósito: é ferramenta interna. %>
    <% storefront = !controller_path.start_with?("admin") %>
    <main class="<%= "theme-d" if storefront %>" <%= 'data-bs-theme=dark' if storefront %>>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
    <!-- AOS JS -->
    <%= javascript_include_tag "https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js", defer: true %>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        AOS.init();
      });
    </script>
  </body>
</html>
