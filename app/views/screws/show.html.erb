<%# =======================
    SEO meta for product page
    Place this block at the very top of app/views/screws/show.html.erb
    It sets <title>, <meta description> and OG/Twitter image via MetaHelper.
    ======================= %>
<%# // Build a human + keyword-friendly title %>
<% meta_title [
     @screw.description.presence,
     (@screw.thread.presence && "(#{@screw.thread})"),
     [@screw.automaker, @screw.model].compact_blank.join(" ")
   ].compact_blank.join(" — ")
%>

<%# // Short meta description (~150–160 chars is ideal).
    // We stitch a sentence from key attributes and truncate just in case. %>
<% meta_description truncate(
     [
       @screw.description,
       @screw.surface_treatment.presence && "Tratamento: #{@screw.surface_treatment}",
       @screw.thread.presence && "Rosca: #{@screw.thread}",
       [@screw.automaker, @screw.model].compact_blank.presence && "Compatível: #{@screw.automaker} #{@screw.model}"
     ].compact_blank.join(". ") + ".",
     length: 160
   )
%>

<%# // Use first image for social previews if available %>
<% if @screw.images.attached? %>
  <% meta_image url_for(@screw.images.first.variant(resize_to_limit: [800, 800])) %>
<% end %>

<%# // Página do produto — redesign direção D. Tokens/componentes de .home-d
    // (components/_home.scss) + estilos próprios em components/_product.scss.
    // A galeria continua com o Stimulus "gallery" (targets main/thumb, ação swap).
    // TODO (3D por produto): o palco .pd-media pode receber um canvas gerado a partir
    // dos dados do parafuso — ver Escritorio-IA/projetos/01-ecommerce/README.md. %>
<% price_label = @screw.price.present? ? number_to_currency(@screw.price, unit: "R$ ", separator: ",", delimiter: ".") : "Sob consulta" %>
<% fit = [@screw.automaker, @screw.model].compact_blank.join(" · ") %>
<% specs = {
     "Rosca" => @screw.thread,
     "Comprimento da rosca" => (@screw.thread_length.present? ? "#{number_with_precision(@screw.thread_length, precision: 1, strip_insignificant_zeros: true, separator: ",")} mm" : nil),
     "Classe de resistência" => @screw.resistance_class,
     "Acabamento" => @screw.surface_treatment,
     "Montadora" => @screw.automaker,
     "Modelo" => @screw.model
   }.select { |_k, v| v.present? } %>

<div class="home-d product-d">
  <div class="hd-container">
    <nav class="pd-crumbs" aria-label="Você está em">
      <%= link_to "Catálogo", screws_path %>
      <% if @screw.automaker.present? %>
        <span aria-hidden="true">/</span>
        <%= link_to @screw.automaker, screws_path(automaker: @screw.automaker) %>
      <% end %>
    </nav>

    <div class="pd-grid">
      <%# ---------- Galeria ---------- %>
      <div class="pd-gallery" data-controller="gallery">
        <%# // Visualizador 3D (screw_viewer_controller): desenha o parafuso a partir das
            // medidas do produto (Screw#viewer_spec). Só carrega ao clicar em "Ver em 3D". %>
        <div class="pd-media" data-controller="screw-viewer"
             data-screw-viewer-spec-value="<%= @screw.viewer_spec.to_json %>"
             data-screw-viewer-logo-value="<%= asset_path("tr-mark.png") %>">
          <div class="pd-media__photo" data-screw-viewer-target="photo">
            <% primary = primary_attachment(@screw) %>
            <% if primary %>
              <%= image_tag primary.variant(resize_to_limit: [1000, 1000]),
                    data: { gallery_target: "main" },
                    alt: @screw.description %>
            <% else %>
              <div class="pd-media__empty">
                <svg width="96" height="96" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 8h24l6 8-6 8H20l-6-8z"/><path d="M26 24v32h12V24"/><path d="M26 30l12 3M26 36l12 3M26 42l12 3M26 48l12 3"/></svg>
                <span>Foto em breve</span>
              </div>
            <% end %>
          </div>

          <div class="pd-media__3d" data-screw-viewer-target="stage" hidden
               role="img" aria-label="Modelo 3D ilustrativo de <%= @screw.description %>, que gira ao arrastar">
            <p class="pd-media__3d-note">Modelo ilustrativo gerado pelas medidas · arraste para girar</p>
          </div>

          <button type="button" class="pd-3d-toggle" aria-pressed="false"
                  data-screw-viewer-target="toggle" data-action="screw-viewer#toggle">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2l9 5v10l-9 5-9-5V7z"/><path d="M12 22V12M21 7l-9 5-9-5"/></svg>
            <span data-screw-viewer-target="label">Ver em 3D</span>
          </button>
        </div>

        <% if @screw.images.attached? && @screw.images.size > 1 %>
          <div class="pd-thumbs" role="list">
            <% @screw.images.each_with_index do |img, i| %>
              <a href="#"
                 class="pd-thumb"
                 role="listitem"
                 aria-label="Ver foto <%= i + 1 %>"
                 data-action="click->gallery#swap"
                 data-gallery-target="thumb"
                 data-url="<%= url_for(img.variant(resize_to_limit: [1000, 1000])) %>">
                <%= image_tag img.variant(resize_to_limit: [200, 200]), alt: "", loading: "lazy", decoding: "async" %>
              </a>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# ---------- Informações e compra ---------- %>
      <div class="pd-info">
        <div class="pd-info__inner">
          <div class="pd-tags">
            <% if @screw.thread.present? %><span class="hd-tag"><%= @screw.thread %></span><% end %>
            <% if @screw.surface_treatment.present? %><span class="pd-tag-outline"><%= @screw.surface_treatment %></span><% end %>
          </div>

          <h1 class="pd-title"><%= @screw.description %></h1>
          <% if fit.present? %><p class="pd-fit">Compatível com <strong><%= fit %></strong></p><% end %>

          <div class="pd-buy" id="pd-buy">
            <div class="pd-price"><%= price_label %></div>
            <% if @screw.in_stock? %>
              <p class="pd-stock pd-stock--ok"><span aria-hidden="true"></span>Em estoque · <%= @screw.stock %> un.</p>
              <%= button_to add_cart_path(screw_id: @screw.id), method: :post, params: { quantity: 1 },
                            class: "hd-btn hd-btn--primary pd-buy__btn", form_class: "pd-buy__form" do %>
                Adicionar ao carrinho
              <% end %>
            <% else %>
              <p class="pd-stock pd-stock--out"><span aria-hidden="true"></span>Sem estoque no momento</p>
              <%= link_to "Pedir por encomenda", root_path(anchor: "pedido-especial"), class: "hd-btn hd-btn--ghost pd-buy__btn" %>
            <% end %>
          </div>

          <% if specs.any? %>
            <section class="pd-specs" aria-labelledby="pd-specs-title">
              <h2 id="pd-specs-title" class="pd-section-title">Ficha técnica</h2>
              <dl>
                <% specs.each do |label, value| %>
                  <div class="pd-spec">
                    <dt><%= label %></dt>
                    <dd><%= value %></dd>
                  </div>
                <% end %>
              </dl>
            </section>
          <% end %>

          <ul class="pd-notes">
            <li>Confira a compatibilidade com o seu veículo antes da compra.</li>
            <li>Frete e prazo calculados no checkout.</li>
          </ul>
        </div>
      </div>
    </div>

    <% if @related.present? %>
      <section class="pd-related" aria-labelledby="pd-related-title">
        <div class="hd-section-head">
          <h2 id="pd-related-title" class="hd-h2">Veja também</h2>
          <%= link_to "Ver catálogo", screws_path, class: "hd-link" %>
        </div>
        <div class="hd-grid">
          <% @related.each do |screw| %>
            <%= render "shared/product_card", screw: screw %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <%# // Barra de compra fixa no celular: o botão continua à vista enquanto a
      // pessoa rola a ficha técnica. Some no desktop (lá a coluna é sticky). %>
  <% if @screw.in_stock? %>
    <div class="pd-mobilebar" aria-hidden="false">
      <div class="pd-mobilebar__price"><%= price_label %></div>
      <%= button_to add_cart_path(screw_id: @screw.id), method: :post, params: { quantity: 1 },
                    class: "hd-btn hd-btn--primary", form_class: "pd-mobilebar__form" do %>
        Comprar
      <% end %>
    </div>
  <% end %>
</div>
