<%# =======================
    SEO meta for product page
    Place this block at the very top of app/views/screws/show.html.erb
    It sets <title>, <meta description> and OG/Twitter image via MetaHelper.
    ======================= %>
<%# // Build a human + keyword-friendly title %>
<% meta_title [
     @screw.description.presence,
     (@screw.thread.presence && "(#{@screw.thread})"),
     [@screw.automaker, @screw.model].compact_blank.join(" ")
   ].compact_blank.join(" — ")
%>

<%# // Short meta description (~150–160 chars is ideal).
    // We stitch a sentence from key attributes and truncate just in case. %>
<% meta_description truncate(
     [
       @screw.description,
       @screw.surface_treatment.presence && "Tratamento: #{@screw.surface_treatment}",
       @screw.thread.presence && "Rosca: #{@screw.thread}",
       [@screw.automaker, @screw.model].compact_blank.presence && "Compatível: #{@screw.automaker} #{@screw.model}"
     ].compact_blank.join(". ") + ".",
     length: 160
   )
%>

<%# // Use first image for social previews if available %>
<% if @screw.images.attached? %>
  <% meta_image url_for(@screw.images.first.variant(resize_to_limit: [800, 800])) %>
<% end %>

<div class="container py-4 py-lg-5" data-controller="gallery">
  <%# // Top link back %>
  <div class="mb-3">
    <%= link_to "← Voltar ao catálogo", screws_path, class: "text-decoration-none" %>
  </div>

  <div class="row gx-3 gy-4 align-items-start">
    <%# // Left column: vertical thumbnails (desktop) — NÃO MEXER (mantido) %>
    <div class="col-12 col-md-auto d-none d-md-flex flex-column gap-2">
      <% if @screw.images.attached? %>
        <% @screw.images.each do |img| %>
          <a href="#"
             class="d-inline-block"
             data-action="click->gallery#swap"
             data-gallery-target="thumb"
             data-url="<%= url_for(img.variant(resize_to_limit: [1000, 1000])) %>">
            <%= image_tag img.variant(resize_to_limit: [200, 200]),
                          class: "rounded border opacity-75",
                          style: "width: 72px; height: 72px; object-fit: cover;",
                          alt: @screw.description,
                          loading: "lazy",
                          decoding: "async" %>
          </a>
        <% end %>
      <% end %>
    </div>

    <%# // Main area: image + details %>
    <div class="col-12 col-md">
      <div class="row gy-4">
        <%# =====================
            Left: main image + mobile thumbs (NÃO MEXER no funcionamento)
            ===================== %>
        <div class="col-12 col-lg-7">
          <%# // pick the newest attached image; nil if none %>
          <% primary = primary_attachment(@screw) %>

          <% if primary %>
            <%= image_tag primary.variant(resize_to_limit: [1000, 1000]),
                  data: { gallery_target: "main" },
                  class: "img-fluid rounded shadow-sm w-100",
                  style: "max-height: 460px; object-fit: contain; background: #fff;",
                  alt: @screw.description %>
          <% else %>
            <div class="bg-light d-flex align-items-center justify-content-center rounded"
                 style="height: 360px;">
              <span class="text-muted">Sem imagens</span>
            </div>
          <% end %>

          <%# // Mobile thumbnails below the main image — mantido %>
          <div class="d-md-none mt-3 d-flex gap-2 overflow-auto">
            <% if @screw.images.attached? %>
              <% @screw.images.each do |img| %>
                <a href="#"
                   class="d-inline-block"
                   data-action="click->gallery#swap"
                   data-gallery-target="thumb"
                   data-url="<%= url_for(img.variant(resize_to_limit: [1000, 1000])) %>">
                  <%= image_tag img.variant(resize_to_limit: [200, 200]),
                                class: "rounded border opacity-75",
                                style: "width: 72px; height: 72px; object-fit: cover;",
                                alt: @screw.description,
                                loading: "lazy",
                                decoding: "async" %>
                </a>
              <% end %>
            <% end %>
          </div>
        </div>

        <%# =====================
            Right: Product details (melhoria visual)
            ===================== %>
        <div class="col-12 col-lg-5">
          <%# // Sticky ajuda a manter o CTA visível no desktop %>
          <div class="position-sticky" style="top: 1rem;">
            <div class="card border-0 shadow-sm">
              <div class="card-body p-4">
                <%# // Badges com info rápida %>
                <div class="d-flex flex-wrap gap-2 mb-2">
                  <% if @screw.thread.present? %>
                    <span class="badge rounded-pill text-bg-light border">Rosca: <%= @screw.thread %></span>
                  <% end %>

                  <% if @screw.surface_treatment.present? %>
                    <span class="badge rounded-pill text-bg-light border"><%= @screw.surface_treatment %></span>
                  <% end %>

                  <%# // Estoque em destaque (sem prometer nada demais) %>
                  <% if @screw.out_of_stock? %>
                    <span class="badge rounded-pill text-bg-secondary">Indisponível</span>
                  <% else %>
                    <span class="badge rounded-pill text-bg-success">Em estoque</span>
                  <% end %>
                </div>

                <h1 class="h3 fw-bold mb-1"><%= @screw.description %></h1>

                <div class="text-muted mb-3">
                  <%= [@screw.automaker, @screw.model].compact_blank.join(" • ") %>
                </div>

                <%# // Specs em formato de tabela (mais “loja”) %>
                <% specs = {
                  "Rosca" => @screw.thread,
                  "Comprimento da rosca" => @screw.thread_length,
                  "Classe de resistência" => @screw.resistance_class,
                  "Tratamento" => @screw.surface_treatment,
                  "Montadora" => @screw.automaker,
                  "Modelo" => @screw.model
                }.select { |_k, v| v.present? } %>

                <% if specs.any? %>
                  <div class="border rounded-3 overflow-hidden mb-4">
                    <div class="px-3 py-2 bg-light fw-semibold">Especificações</div>

                    <div class="table-responsive">
                      <table class="table table-sm mb-0 align-middle">
                        <tbody>
                          <% specs.each do |label, value| %>
                            <tr>
                              <td class="text-muted" style="width: 52%;"><%= label %></td>
                              <td class="fw-semibold"><%= value %></td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                <% end %>

                <%# // Caixa de preço + CTA %>
                <div class="p-3 bg-light rounded-3 d-flex align-items-center justify-content-between gap-3">
                  <div>
                    <div class="fs-3 fw-bold mb-1"><%= format_price(@screw.price) %></div>

                    <% if @screw.out_of_stock? %>
                      <small class="text-muted">Sem estoque no momento</small>
                    <% else %>
                      <small class="text-muted">Estoque: <%= @screw.stock %> un.</small>
                    <% end %>
                  </div>

                  <div class="text-end">
                    <% if @screw.in_stock? %>
                      <%= button_to "COMPRAR",
                                    add_cart_path(screw_id: @screw.id),
                                    method: :post,
                                    params: { quantity: 1 },
                                    class: "btn btn-yellow px-4 py-2 fw-semibold" %>
                    <% else %>
                      <button class="btn btn-secondary px-4 py-2" disabled>Sem estoque</button>
                    <% end %>
                  </div>
                </div>

                <%# // Texto pequeno opcional (neutro, sem promessas) %>
                <div class="small text-muted mt-3">
                  <div>• Confira compatibilidade antes da compra.</div>
                  <div>• Frete e prazo são calculados no checkout.</div>
                </div>
              </div>
            </div>
          </div>
          <%# // end sticky %>
        </div>
      </div>
    </div>
  </div>
</div>
