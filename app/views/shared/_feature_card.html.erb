<%#
  Componente reutilizável de card metálico
  Locals esperados:
  - title: título do card (aceita html_safe com <br>)
  - text: texto do card
%>

<div class="tr-feature-card">
  <%# PARAFUSOS DESATIVADOS - para reativar, troque "false" por "true" abaixo e ajuste o TR para igualar ao logo %>
  <% if false %>
  <!-- Parafusos nos 4 cantos -->
  <div class="tr-screw tr-screw--top-left" aria-hidden="true">
    <svg viewBox="0 0 64 64" class="tr-screw__svg" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="screwMetalA" cx="35%" cy="30%" r="70%">
          <stop offset="0%" stop-color="#ffffff" />
          <stop offset="35%" stop-color="#d8d8d8" />
          <stop offset="65%" stop-color="#8f8f8f" />
          <stop offset="100%" stop-color="#f3f3f3" />
        </radialGradient>
        <linearGradient id="screwSlotA" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#3a3a3a" />
          <stop offset="50%" stop-color="#151515" />
          <stop offset="100%" stop-color="#2a2a2a" />
        </linearGradient>
      </defs>
      <circle cx="32" cy="32" r="30" fill="#1c1c1c"/>
      <circle cx="32" cy="32" r="27" fill="url(#screwMetalA)" stroke="#d9d9d9" stroke-width="1.5"/>
      <circle cx="32" cy="32" r="22" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1"/>
      <circle cx="32" cy="32" r="18" fill="none" stroke="rgba(0,0,0,0.18)" stroke-width="1"/>
      <g fill="url(#screwSlotA)">
        <rect x="22" y="29" width="20" height="6" rx="1.5"/>
        <rect x="29" y="22" width="6" height="20" rx="1.5"/>
      </g>
    </svg>
  </div>

  <div class="tr-screw tr-screw--top-right" aria-hidden="true">
    <svg viewBox="0 0 64 64" class="tr-screw__svg" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="screwMetalB" cx="35%" cy="30%" r="70%">
          <stop offset="0%" stop-color="#ffffff" />
          <stop offset="35%" stop-color="#d8d8d8" />
          <stop offset="65%" stop-color="#8f8f8f" />
          <stop offset="100%" stop-color="#f3f3f3" />
        </radialGradient>
        <linearGradient id="screwSlotB" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#3a3a3a" />
          <stop offset="50%" stop-color="#151515" />
          <stop offset="100%" stop-color="#2a2a2a" />
        </linearGradient>
      </defs>
      <circle cx="32" cy="32" r="30" fill="#1c1c1c"/>
      <circle cx="32" cy="32" r="27" fill="url(#screwMetalB)" stroke="#d9d9d9" stroke-width="1.5"/>
      <circle cx="32" cy="32" r="22" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1"/>
      <circle cx="32" cy="32" r="18" fill="none" stroke="rgba(0,0,0,0.18)" stroke-width="1"/>
      <g fill="url(#screwSlotB)">
        <rect x="22" y="29" width="20" height="6" rx="1.5"/>
        <rect x="29" y="22" width="6" height="20" rx="1.5"/>
      </g>
    </svg>
  </div>

  <div class="tr-screw tr-screw--bottom-left" aria-hidden="true">
    <svg viewBox="0 0 64 64" class="tr-screw__svg" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="screwMetalC" cx="35%" cy="30%" r="70%">
          <stop offset="0%" stop-color="#ffffff" />
          <stop offset="35%" stop-color="#d8d8d8" />
          <stop offset="65%" stop-color="#8f8f8f" />
          <stop offset="100%" stop-color="#f3f3f3" />
        </radialGradient>
        <linearGradient id="screwSlotC" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#3a3a3a" />
          <stop offset="50%" stop-color="#151515" />
          <stop offset="100%" stop-color="#2a2a2a" />
        </linearGradient>
      </defs>
      <circle cx="32" cy="32" r="30" fill="#1c1c1c"/>
      <circle cx="32" cy="32" r="27" fill="url(#screwMetalC)" stroke="#d9d9d9" stroke-width="1.5"/>
      <circle cx="32" cy="32" r="22" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1"/>
      <circle cx="32" cy="32" r="18" fill="none" stroke="rgba(0,0,0,0.18)" stroke-width="1"/>
      <g fill="url(#screwSlotC)">
        <rect x="22" y="29" width="20" height="6" rx="1.5"/>
        <rect x="29" y="22" width="6" height="20" rx="1.5"/>
      </g>
    </svg>
  </div>

  <div class="tr-screw tr-screw--bottom-right" aria-hidden="true">
    <svg viewBox="0 0 64 64" class="tr-screw__svg" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="screwMetalD" cx="35%" cy="30%" r="70%">
          <stop offset="0%" stop-color="#ffffff" />
          <stop offset="35%" stop-color="#d8d8d8" />
          <stop offset="65%" stop-color="#8f8f8f" />
          <stop offset="100%" stop-color="#f3f3f3" />
        </radialGradient>
        <linearGradient id="screwSlotD" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#3a3a3a" />
          <stop offset="50%" stop-color="#151515" />
          <stop offset="100%" stop-color="#2a2a2a" />
        </linearGradient>
      </defs>
      <circle cx="32" cy="32" r="30" fill="#1c1c1c"/>
      <circle cx="32" cy="32" r="27" fill="url(#screwMetalD)" stroke="#d9d9d9" stroke-width="1.5"/>
      <circle cx="32" cy="32" r="22" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1"/>
      <circle cx="32" cy="32" r="18" fill="none" stroke="rgba(0,0,0,0.18)" stroke-width="1"/>
      <g fill="url(#screwSlotD)">
        <rect x="22" y="29" width="20" height="6" rx="1.5"/>
        <rect x="29" y="22" width="6" height="20" rx="1.5"/>
      </g>
    </svg>
  </div>
  <% end %>

  <!-- Conteúdo interno do card -->
  <div class="tr-feature-card__content">
    <div class="tr-feature-card__icon" aria-hidden="true">
      <svg viewBox="0 0 72 72" class="tr-check__svg" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="checkGreen" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#76ff5f"/>
            <stop offset="45%" stop-color="#29c73d"/>
            <stop offset="100%" stop-color="#0b7f1f"/>
          </linearGradient>
        </defs>
        <rect x="10" y="12" width="40" height="40" rx="5" fill="none" stroke="url(#checkGreen)" stroke-width="4"/>
        <path d="M21 33 L31 42 L54 19" fill="none" stroke="url(#checkGreen)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <div class="tr-feature-card__body">
      <h3 class="tr-feature-card__title"><%= title %></h3>
      <p class="tr-feature-card__text"><%= text %></p>
    </div>
  </div>
</div>
