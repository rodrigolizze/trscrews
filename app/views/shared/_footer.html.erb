<%# // Rodapé — redesign direção D. Os dados da empresa (Decreto 7.962/2013, art. 2º)
    // vêm de config/initializers/company.rb (ENV no Heroku); linha sem dado configurado
    // não aparece, para nunca mostrar dado fictício. Original em
    // Escritorio-IA/.../redesign/backup-original/. %>
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <%= link_to root_path, class: "site-footer__logo" do %>TR <span>AUTOFIX</span><% end %>
      <p>Parafusos de roda aftermarket.</p>
    </div>

    <nav class="site-footer__col" aria-label="Loja">
      <h2 class="site-footer__title">Loja</h2>
      <%= link_to "Produtos", screws_path %>
      <%= link_to "Pedido especial", root_path(anchor: "pedido-especial") %>
      <%= link_to "Carrinho", cart_path %>
    </nav>

    <nav class="site-footer__col" aria-label="Minha conta">
      <h2 class="site-footer__title">Minha conta</h2>
      <% if defined?(user_signed_in?) && user_signed_in? %>
        <%= link_to "Meus pedidos", my_orders_path %>
        <%= link_to "Meus endereços", shipping_addresses_path %>
      <% else %>
        <%= link_to "Entrar", new_user_session_path %>
        <%= link_to "Criar conta", new_user_registration_path %>
      <% end %>
    </nav>

    <nav class="site-footer__col" aria-label="Políticas">
      <h2 class="site-footer__title">Políticas</h2>
      <%= link_to "Trocas e devoluções", returns_policy_path %>
      <%= link_to "Privacidade", privacy_policy_path %>
      <%= link_to "Termos de uso", terms_of_use_path %>
    </nav>
  </div>

  <div class="site-footer__bottom">
    <% company_lines = [
         (company_identification if company.legal_name || company.cnpj),
         company.address
       ].compact %>
    <% if company_lines.any? || company_contact_links.any? %>
      <p class="site-footer__company">
        <%= company_lines.join(" · ") %>
        <% if company_contact_links.any? %>
          <%= " · " if company_lines.any? %><%= safe_join(company_contact_links, " · ") %>
        <% end %>
      </p>
    <% end %>
    <p class="site-footer__copy">&copy; <%= Time.current.year %> <%= company.trade_name %>. Todos os direitos reservados.</p>
  </div>
</footer>
