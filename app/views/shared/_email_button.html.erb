<%# Call-to-action button for e-mails (bulletproof enough: a padded link). Locals: label, url. %>
<p style="margin:22px 0;" align="center">
  <%= link_to label, url,
              style: "display:inline-block; padding:13px 26px; background-color:#FFC400; color:#121417; " \
                     "font-weight:700; font-size:14px; text-transform:uppercase; letter-spacing:0.5px; " \
                     "text-decoration:none; border-radius:3px;" %>
</p>
<p style="margin:0 0 16px 0; font-size:12px; color:#6b7280; word-break:break-all;">
  Se o botão não funcionar, copie e cole este link no navegador:<br />
  <%= url %>
</p>
