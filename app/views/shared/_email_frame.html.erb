<%# Branded frame shared by every e-mail (orders and account/Devise).
    E-mail clients only render inline styles and table layouts reliably:
    no external CSS, no flex/grid, no gradients (the hazard stripe is a plain
    yellow bar). The logo is a PNG (Outlook does not show WebP) and becomes an
    absolute URL through config.action_mailer.asset_host in production.
    Locals: body (rendered HTML), preheader (optional inbox preview text). %>
<% company = Rails.configuration.x.company %>
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body style="margin:0; padding:0; background-color:#eceef1;">
    <% if local_assigns[:preheader].present? %>
      <div style="display:none; max-height:0; overflow:hidden; mso-hide:all;"><%= preheader %></div>
    <% end %>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#eceef1; padding:28px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                 style="max-width:560px; background-color:#ffffff; border-radius:6px; overflow:hidden;
                        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; color:#1f2328;">
            <tr>
              <td align="center" style="background-color:#121417; padding:20px 24px;">
                <%= image_tag "logo-tr-autofix-nav.png", alt: "TR AutoFix", width: 92, height: 56,
                              style: "display:block; border:0;" %>
              </td>
            </tr>
            <tr>
              <td style="height:6px; background-color:#FFC400; font-size:0; line-height:0;">&nbsp;</td>
            </tr>
            <tr>
              <td style="padding:28px 32px 24px; font-size:15px; line-height:1.55;">
                <%= body %>
                <p style="margin:24px 0 0 0; font-size:14px; color:#4b5563;">
                  Abraços,<br />
                  Equipe TR AutoFix
                </p>
              </td>
            </tr>
            <tr>
              <td style="background-color:#f6f7f9; padding:18px 32px; border-top:1px solid #e6e8eb;
                         font-size:12px; line-height:1.6; color:#6b7280;">
                Dúvidas? É só responder este e-mail.<br />
                <strong style="color:#374151;"><%= company.trade_name %></strong> · Parafusos de roda aftermarket
                <% if company.legal_name && company.cnpj %>
                  <br /><%= company.legal_name %> · CNPJ <%= company.cnpj %>
                <% end %>
                <% if company.address %>
                  <br /><%= company.address %>
                <% end %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
