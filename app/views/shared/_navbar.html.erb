<nav class="navbar navbar-expand-lg" style="background-color: $color-owhite;">
  <div class="container-fluid px-0 py-0">
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
      <%= image_tag "logo-tr-autofix.png",
            alt: "TR AutoFix - Peças Automotivas",
            class: "navbar-logo" %>
    <% end %>

    <%# // Abre o menu abaixo de lg. O Bootstrap esconde este botão em >=992px
        // (.navbar-expand-lg .navbar-toggler { display: none }), então no desktop
        // nada muda — lá o menu já é sempre visível. O grupo da direita
        // (Carrinho / Entrar / Cadastrar) fica FORA do collapse de propósito:
        // esconder o carrinho atrás do hambúrguer custaria conversão. %>
    <button class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNav"
            aria-controls="mainNav"
            aria-expanded="false"
            aria-label="Abrir menu de navegação">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-center" id="mainNav">
      <ul class="navbar-nav mb-2 mb-lg-0 gap-3">
        <li class="nav-item"><%= link_to "Início", root_path, class: "nav-link" %></li>
        <li class="nav-item"><%= link_to "Produtos", screws_path, class: "nav-link" %></li>
        <li class="nav-item"><a class="nav-link" href="#">Sobre Nós</a></li>
        <li class="nav-item"><a class="nav-link" href="#">FAQ</a></li>
        <%# // Show Admin link only in development %>
        <% if Rails.env.development? %>
          <li class="nav-item ms-2">
            <%= link_to "Admin", admin_root_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="d-flex align-items-center gap-3">
      <%# // Cart link (kept as-is) %>
      <%= link_to cart_path, class: "nav-link d-flex align-items-center gap-1" do %>
        <span class="me-1">🛒</span>
        <span>Carrinho</span>
        <% if cart_count.to_i > 0 %>
          <span class="badge bg-warning text-dark ms-1"><%= cart_count %></span>
        <% end %>
      <% end %>

      <%# // If signed in: show "Meus pedidos" + user menu %>
      <% if defined?(user_signed_in?) && user_signed_in? %>
        <% display_name = current_user.name.presence || current_user.email %>

        <div class="dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="userMenu" role="button"
            data-bs-toggle="dropdown" aria-expanded="false">
            <%= display_name %> <!-- // prefer name, fallback to email -->
          </a>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
            <li><%= link_to "Meus pedidos", my_orders_path, class: "dropdown-item" %></li>
            <li><%= link_to "Editar conta", edit_user_registration_path, class: "dropdown-item" %></li>
            <li><%= link_to "Meus endereços", shipping_addresses_path, class: "dropdown-item" %></li>
            <li><hr class="dropdown-divider"></li>
            <li><%= button_to "Sair", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
          </ul>
        </div>
      <% else %>
        <%# // If not signed in: show Devise links %>
        <%= link_to "Entrar", new_user_session_path, class: "text-dark nav-link" %>
        <%= link_to "Cadastrar", new_user_registration_path,
                    class: "btn text-white rounded-pill px-3",
                    style: "background-color: $color-secondary;" %>
      <% end %>
    </div>
  </div>
</nav>
