<%# // Redesign (direção D): navbar escura. data-bs-theme="dark" deixa o ícone do
    // hambúrguer e o dropdown do usuário claros sobre o fundo escuro. %>
<nav class="navbar navbar-expand-lg site-nav" data-bs-theme="dark" data-controller="navbar">
  <div class="container-fluid px-0 py-0">
    <%# // Logo metálico (arte final, fundo transparente), recortado e reduzido para
        // 2× a altura exibida. WebP com PNG de reserva; width/height evitam que a
        // barra "pule" enquanto a imagem carrega. %>
    <%= link_to root_path, class: "navbar-brand site-nav__brand", aria: { label: "TR AutoFix — início" } do %>
      <picture>
        <source srcset="<%= asset_path("logo-tr-autofix-nav.webp") %>" type="image/webp">
        <%= image_tag "logo-tr-autofix-nav.png", alt: "", width: 184, height: 112,
              class: "site-nav__logo", fetchpriority: "high" %>
      </picture>
    <% end %>

    <%# // Abre o menu abaixo de lg. O Bootstrap esconde este botão em >=992px
        // (.navbar-expand-lg .navbar-toggler { display: none }), então no desktop
        // nada muda — lá o menu já é sempre visível. O grupo da direita
        // (Carrinho / Entrar / Cadastrar) fica FORA do collapse de propósito:
        // esconder o carrinho atrás do hambúrguer custaria conversão. %>
    <button class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNav"
            aria-controls="mainNav"
            aria-expanded="false"
            aria-label="Abrir menu de navegação">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-center" id="mainNav" data-navbar-target="menu">
      <ul class="navbar-nav mb-2 mb-lg-0 gap-3">
        <li class="nav-item"><%= link_to "Início", root_path, class: "nav-link" %></li>
        <li class="nav-item"><%= link_to "Produtos", screws_path, class: "nav-link" %></li>
        <li class="nav-item"><a class="nav-link" href="#">Sobre Nós</a></li>
        <li class="nav-item"><a class="nav-link" href="#">FAQ</a></li>
        <%# // Show Admin link only in development %>
        <% if Rails.env.development? %>
          <li class="nav-item ms-2">
            <%= link_to "Admin", admin_root_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="d-flex align-items-center gap-2 gap-sm-3 site-nav__right">
      <%# // Cart link (kept as-is) %>
      <%= link_to cart_path, class: "nav-link site-nav__cart" do %>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 4h2l2.4 11h11l2-8H6.2"/><circle cx="9" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/></svg>
        <span class="site-nav__cart-label">Carrinho</span>
        <% if cart_count.to_i > 0 %>
          <span class="site-nav__badge"><%= cart_count %></span>
        <% end %>
      <% end %>

      <%# // If signed in: show "Meus pedidos" + user menu %>
      <% if defined?(user_signed_in?) && user_signed_in? %>
        <% display_name = current_user.name.presence || current_user.email %>

        <div class="dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="userMenu" role="button"
            data-bs-toggle="dropdown" aria-expanded="false">
            <%= display_name %> <!-- // prefer name, fallback to email -->
          </a>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
            <li><%= link_to "Meus pedidos", my_orders_path, class: "dropdown-item" %></li>
            <li><%= link_to "Editar conta", edit_user_registration_path, class: "dropdown-item" %></li>
            <li><%= link_to "Meus endereços", shipping_addresses_path, class: "dropdown-item" %></li>
            <li><hr class="dropdown-divider"></li>
            <li><%= button_to "Sair", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
          </ul>
        </div>
      <% else %>
        <%# // If not signed in: show Devise links %>
        <%= link_to "Entrar", new_user_session_path, class: "nav-link" %>
        <%= link_to "Cadastrar", new_user_registration_path, class: "site-nav__cta" %>
      <% end %>
    </div>
  </div>
</nav>
