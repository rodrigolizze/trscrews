<%# // Formulário reutilizável para new/edit. Usa @shipping_address e deixa o Rails inferir a rota. %>

<%= form_with model: @shipping_address,                 # // chave: usa o nome do model
              local: true,
              html: { class: "card shadow-sm" } do |f| %>
              <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>

  <div class="card-body">
    <%# // Erros de validação %>
    <% if @shipping_address.errors.any? %>
      <div class="alert alert-danger">
        <strong><%= pluralize(@shipping_address.errors.count, "erro") %> ao salvar:</strong>
        <ul class="mb-0">
          <% @shipping_address.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="row g-3">
      <div class="col-md-8">
        <div class="mb-3">
          <%= f.label :recipient_name, "Nome do destinatário", class: "form-label" %>
          <%= f.text_field :recipient_name, class: "form-control", required: true %>
        </div>

        <div data-controller="cep">  <%# // enable CEP autofill for this form %>

          <div class="row g-3">
            <div class="col-md-4">
              <%= f.label :cep, "CEP", class: "form-label" %>
              <%= f.text_field :cep,
                    class: "form-control",
                    placeholder: "00000-000",
                    maxlength: 9,
                    required: true,
                    data: {
                      cep_target: "cep",
                      action: "input->cep#debouncedLookup blur->cep#lookup"  # keep lookup; mask handled by fallback
                    } %>
              <div data-cep-target="feedback" class="small text-muted mt-1"></div>

              <!-- CEP mask fallback (nonce-safe, no Stimulus/importmap needed) -->
              <script nonce="<%= content_security_policy_nonce %>">
                (function () {
                  function q(sel){ return document.querySelector(sel); }
                  function digits(s){ return (s||"").replace(/\D/g,""); }
                  function setVal(el, v){
                    if (!el) return;
                    el.value = v || "";
                    el.dispatchEvent(new Event("input", { bubbles: true }));
                  }

                  function mask(el){
                    var ds = digits(el.value).slice(0, 8);
                    el.value = ds.length > 5 ? ds.slice(0,5) + "-" + ds.slice(5) : ds;
                  }

                  function lookup(el){
                    var ds = digits(el.value);
                    if (ds.length !== 8) return;

                    var fb = q('[data-cep-target="feedback"]');
                    if (el.dataset.lastReq === ds) return;       // avoid repeat calls
                    el.dataset.lastReq = ds;

                    if (fb) fb.textContent = "Consultando CEP...";

                    fetch("/cep/" + ds, { headers: { "Accept": "application/json" }, credentials: "same-origin" })
                      .then(function(res){ return res.json().then(function(j){ return { ok: res.ok, j: j }; }); })
                      .then(function(r){
                        if (!r.ok) throw new Error((r.j && r.j.error) || "Falha ao consultar CEP");
                        setVal(q('[data-cep-target="street"]'),   r.j.street);
                        setVal(q('[data-cep-target="district"]'), r.j.district);
                        setVal(q('[data-cep-target="city"]'),     r.j.city);
                        setVal(q('[data-cep-target="state"]'),    r.j.state);
                        if (r.j.cep) el.value = r.j.cep;          // normalize "12345-678"
                        if (fb) fb.textContent = "Endereço preenchido pelo CEP.";
                      })
                      .catch(function(err){
                        if (fb) fb.textContent = err.message || "Falha na consulta do CEP.";
                      });
                  }

                  function bind(){
                    var el = q('[data-cep-target="cep"]');
                    if (!el || el.dataset.manualBound) return;    // bind once
                    el.dataset.manualBound = "1";

                    el.addEventListener("input", function(){
                      mask(el);
                      clearTimeout(el._t);
                      el._t = setTimeout(function(){ lookup(el); }, 350); // debounce
                    }, { passive: true });

                    el.addEventListener("blur", function(){
                      mask(el);
                      lookup(el);
                    });

                    mask(el); // format initial value
                  }

                  document.addEventListener("turbo:load", bind);
                  document.addEventListener("DOMContentLoaded", bind);
                })();
              </script>
            </div>

            <div class="col-md-8">
              <%= f.label :street, "Rua", class: "form-label" %>
              <%= f.text_field :street, class: "form-control", required: true, data: { cep_target: "street" } %>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-md-4">
              <%= f.label :number, "Número", class: "form-label" %>
              <%= f.text_field :number, class: "form-control", required: true %>
            </div>
            <div class="col-md-8">
              <%= f.label :complement, "Complemento", class: "form-label" %>
              <%= f.text_field :complement, class: "form-control" %>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-md-4">
              <%= f.label :district, "Bairro", class: "form-label" %>
              <%= f.text_field :district, class: "form-control", required: true, data: { cep_target: "district" } %>
            </div>
            <div class="col-md-5">
              <%= f.label :city, "Cidade", class: "form-label" %>
              <%= f.text_field :city, class: "form-control", required: true, data: { cep_target: "city" } %>
            </div>
            <div class="col-md-3">
              <%= f.label :state, "UF", class: "form-label" %>
              <%= f.select :state,
                    options_for_select(Rails.configuration.x.shipping.uf_codes, @shipping_address.state),
                    { prompt: "Selecione a UF" },
                    class: "form-select", required: true, data: { cep_target: "state" } %>
            </div>
          </div>

        </div> <%# // /data-controller="cep" %>
      </div>
    </div>
  </div>

  <div class="card-footer d-flex gap-2">
    <%= f.submit (@shipping_address.persisted? ? "Atualizar" : "Salvar"), class: "btn btn-primary" %>
    <%= link_to "Cancelar",
            (params[:return_to] == "checkout" ? checkout_path(address_id: @shipping_address&.id) : shipping_addresses_path),
            class: "btn btn-outline-secondary" %>
  </div>
<% end %>
