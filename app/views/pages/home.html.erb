<% content_for :head do %>
  <script type="module" nonce="<%= content_security_policy_nonce %>">import "screw_3d";</script>
<% end %>

<%# // Home — direção visual D (ver Escritorio-IA/projetos/01-ecommerce/redesign/guia-de-estilo.md).
    // Estilos escopados em .home-d para não afetar as outras páginas antes do redesign delas. %>
<div class="home-d">

  <section class="hd-hero">
    <div class="hd-container hd-hero__grid">
      <div class="hd-hero__text">
        <p class="hd-eyebrow">Parafusos de roda aftermarket</p>
        <h1 class="hd-display">Aperto certo. Peça certa.</h1>
        <p class="hd-lead">Qualidade, performance e preço justo em um só lugar. Encontre o parafuso pela medida ou pelo seu carro.</p>
        <div class="hd-actions">
          <%= link_to screws_path, class: "hd-btn hd-btn--primary" do %>
            Ver produtos
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          <% end %>
          <%= link_to "Pedido especial", "#pedido-especial", class: "hd-btn hd-btn--ghost" %>
        </div>
      </div>

      <%# // Palco do parafuso 3D: o tamanho vem do CSS (.hd-hero__visual), o canvas só ocupa 100%. %>
      <div class="hd-hero__visual">
        <div id="screw-3d-root" data-screw-model="<%= asset_path('screw.glb') %>" role="img" aria-label="Parafuso de roda em 3D que gira conforme a rolagem da página"></div>
        <span class="hd-spec">M12-1,5 · 30 mm · Geomet</span>
        <span class="hd-hint" aria-hidden="true">
          Role para girar
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
        </span>
      </div>
    </div>
  </section>

  <div class="hd-stripe" aria-hidden="true"></div>

  <section class="hd-container hd-values" id="por-que-tr-autofix" aria-label="Por que escolher a TR AutoFix">
    <% [
         ["01", "Qualidade", "Fornecedores confiáveis e peças com padrão de qualidade."],
         ["02", "Entrega", "Envio para todo o Brasil com agilidade e segurança."],
         ["03", "Suporte", "Equipe com experiência no setor para tirar dúvidas."],
         ["04", "Fabricante", "Produtos direto com fornecedores que resolvem."]
       ].each do |num, title, text| %>
      <div class="hd-value">
        <div class="hd-value__num"><%= num %></div>
        <h2 class="hd-value__title"><%= title %></h2>
        <p class="hd-value__text"><%= text %></p>
      </div>
    <% end %>
  </section>

  <section class="hd-container hd-products" aria-labelledby="hd-products-title">
    <div class="hd-section-head">
      <h2 id="hd-products-title" class="hd-h2">Em destaque</h2>
      <%= link_to "Ver todos os produtos", screws_path, class: "hd-link" %>
    </div>

    <div class="hd-grid">
      <% @featured_screws.each do |screw| %>
        <%= render "shared/product_card", screw: screw %>
      <% end %>
    </div>
  </section>

  <section class="hd-container hd-special" id="pedido-especial">
    <div class="hd-special__box">
      <div class="hd-special__text">
        <h2 class="hd-h2">Medida fora do catálogo?</h2>
        <p>Peça itens especiais ou em maior quantidade. Respondemos com orçamento.</p>
      </div>
      <%# // TODO: o formulário de pedido especial ainda não existe — o link antigo também era "#". %>
      <a href="#" class="hd-btn hd-btn--primary">Fazer pedido especial</a>
    </div>
  </section>

</div>
