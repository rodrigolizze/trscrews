<section class="banner-dark banner-full-bleed">
  <div id="fullHeroCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">

      <!-- Slide 1: Text + 3 imagens (banner como fundo) -->
      <div class="carousel-item active" style="background-image: url('<%= asset_path('banner-tr-autofix.png') %>'); background-size: cover; background-position: center;">
        <div class="container py-5">
          <div class="row align-items-center text-light-custom">
            <div class="col-md-6 banner-hero-text">
              <h1 class="display-5 fw-bold">
                Peças <span class="text-primary-custom">Aftermarket</span><br>
                de alta performance.
              </h1>
              <p class="mt-3">Transforme seu veículo com as melhores peças do mercado.<br>
                Qualidade, performance e preço justo em um só lugar.
              </p>
                <div class="container">
                  <%= link_to "Ver Produtos →", screws_path, class: "btn btn-yellow" %>
                </div>
            </div>

            <div class="col-md-6 d-flex justify-content-center gap-3">
              <% 3.times do |i| %>
                <%= image_tag "banner#{i + 1}.jpeg", alt: "Produto destaque #{i + 1}", class: "banner-hero-card rounded", style: "width: 240px; height: 240px; object-fit: cover;" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 2 -->
      <div class="carousel-item">
        <div class="container text-light-custom text-center py-5">
          <h2 class="fw-bold">🚗 Encontre o kit ideal para seu carro</h2>
          <p class="lead mt-3">Temos milhares de parafusos, kits e acessórios compatíveis com seu modelo.</p>
            <div class ="container">
              <%= link_to "Ver Catálogo →", screws_path, class: "btn btn-yellow" %>
            </div>
        </div>
      </div>

      <!-- Slide 3 -->
      <div class="carousel-item">
        <div class="container text-light-custom text-center py-5">
          <h2 class="fw-bold">💡 Faça pedidos personalizados</h2>
          <p class="lead mt-3">Não achou o que precisa? Envie seu pedido especial.</p>
            <div class="container">
              <a href="#" class="btn btn-yellow">Fazer Pedido →</a>
            </div>
        </div>
      </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#fullHeroCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#fullHeroCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
    </button>
  </div>
</section>

<section class="py-5 bg-gray-custom text-title-custom text-center">
  <div class="container">
    <h2 class="mb-3 fw-bold">Por que escolher a TR AutoFix?</h2>
    <p class="mb-5 text-title-custom">
      Do dia a dia da oficina ao projeto em casa: oferecemos fixadores e autopeças com padrão de qualidade, entrega rápida e atendimento para tirar dúvidas antes e depois da compra.
    </p>

    <% advertisings = [
      { icon: "check2-square", title: "Qualidade Garantida", text: "Fornecedores confiáveis e dispostos a dar o melhor." },
      { icon: "check2-square", title: "Entrega Rápida", text: "Entregamos em todo o Brasil com agilidade e segurança." },
      { icon: "check2-square", title: "Suporte Técnico", text: "Equipe com experiência no setor." },
      { icon: "check2-square", title: "Produtos diretamente com o fabricante.", text: "Fornecedores dispostos a solucionar o problema." }
    ] %>

    <div class="row row-cols-1 row-cols-md-4 g-4 ">
      <% advertisings.each_with_index do |advertising, index| %>
        <div class="col" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
          <%= render "shared/feature_card", icon: advertising[:icon], title: advertising[:title], text: advertising[:text] %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="py-5 text-center text-title-custom bg-light-custom">
  <div class="container">
    <h2 class="fw-bold mb-2">Produtos em Destaque</h2>
    <p class="text-gray-custom mb-5">
      Confira nossa seleção de produtos mais procurados.
    </p>
    <div class="row row-cols-1 row-cols-md-4 g-4">
      <% @featured_screws.each_with_index do |screw, index| %>
        <% carousel_id = "productCarousel-#{SecureRandom.hex(4)}" %>

        <div class="col">
          <div class="card h-100 d-flex flex-column">
            <!-- // Carousel (altura fixa já ajuda bastante) -->
            <div id="<%= carousel_id %>" class="carousel slide" data-bs-ride="carousel">
              <div class="carousel-inner">
                <% screw.images.each_with_index do |img, index| %>
                  <div class="carousel-item <%= 'active' if index == 0 %>">
                    <%= image_tag img, class: "d-block w-100", style: "height: 200px; object-fit: cover;" %>
                  </div>
                <% end %>
              </div>

              <button class="carousel-control-prev" type="button" data-bs-target="#<%= carousel_id %>" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>

              <button class="carousel-control-next" type="button" data-bs-target="#<%= carousel_id %>" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </div>

            <!-- // Card content vira flex-column e ocupa o resto da altura -->
            <div class="card-body text-center d-flex flex-column flex-grow-1">
              <small class="text-muted"><%= screw.thread %> — <%= screw.surface_treatment %></small>

              <h6 class="fw-bold mt-2"><%= screw.description %></h6>

              <p class="mb-1 text-muted"><%= screw.automaker %> - <%= screw.model %></p>

              <p class="fw-bold mb-3">R$ <%= screw.price %></p>

              <!-- // mt-auto empurra o botão para o fundo do card -->
              <%= link_to "VER DETALHES", screw_path(screw), class: "btn btn-yellow w-100 mt-auto" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="py-5 text-center bg-gray-custom text-title-custom text-white">
  <div class="container">
    <h3 class="fw-bold mb-3">
      Precisa de um item fora do catálogo ou em maior quantidade?
    </h3>
    <p class="mb-4 text-title-custom">
      Envie um pedido especial preenchendo um de nossos formulários personalizados.
    </p>
    <%= link_to "Fazer Pedido →", "#", class: "btn btn-yellow px-4 py-2 fw-bold shadow-sm" %>
  </div>
</section>
