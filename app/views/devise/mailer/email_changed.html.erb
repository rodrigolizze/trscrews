<%= render layout: "devise/mailer/frame", locals: { preheader: "O e-mail de acesso da sua conta TR AutoFix mudou." } do %>
  <h1 style="margin:0 0 14px 0; font-size:22px; line-height:1.25;">E-mail de acesso alterado</h1>
  <p style="margin:0 0 12px 0;">Olá!</p>
  <% if @resource.try(:unconfirmed_email?) %>
    <p style="margin:0 0 12px 0;">O e-mail de acesso da sua conta na TR AutoFix está sendo alterado para <strong><%= @resource.unconfirmed_email %></strong>.</p>
  <% else %>
    <p style="margin:0 0 12px 0;">O e-mail de acesso da sua conta na TR AutoFix foi alterado para <strong><%= @resource.email %></strong>.</p>
  <% end %>
  <p style="margin:0; font-size:13px; color:#6b7280;">Se não foi você, fale com a gente o quanto antes.</p>
<% end %>
