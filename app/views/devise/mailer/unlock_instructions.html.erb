<%= render layout: "devise/mailer/frame" do %>
  <p style="margin:0 0 12px 0;">Olá <strong><%= @resource.name.presence || @resource.email %></strong>,</p>
  <p style="margin:0 0 16px 0;">Sua conta foi bloqueada depois de várias tentativas de login sem sucesso. Para desbloquear, clique no link abaixo:</p>
  <p style="margin:0;"><%= link_to "Desbloquear minha conta", unlock_url(@resource, unlock_token: @token) %></p>
<% end %>
