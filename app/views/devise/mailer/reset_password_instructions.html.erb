<%= render layout: "devise/mailer/frame" do %>
  <p style="margin:0 0 12px 0;">Olá <strong><%= @resource.name.presence || @resource.email %></strong>,</p>

  <p style="margin:0 0 16px 0;">
    Recebemos um pedido para redefinir a senha da sua conta na TR AutoFix. Para criar uma senha nova, clique no botão abaixo:
  </p>

  <p style="margin:0 0 16px 0;" align="center">
    <%= link_to "Criar nova senha",
                edit_password_url(@resource, reset_password_token: @token),
                style: "display:inline-block; padding:12px 24px; border-radius:999px; text-decoration:none; font-weight:600; font-size:15px; background-color:#2563eb; color:#ffffff;" %>
  </p>

  <p style="margin:0 0 8px 0; font-size:13px; color:#6b7280;">Se o botão não funcionar, copie e cole este link no seu navegador:</p>
  <p style="margin:0 0 16px 0; font-size:13px; color:#2563eb; word-break:break-all;">
    <%= edit_password_url(@resource, reset_password_token: @token) %>
  </p>

  <p style="margin:0; font-size:13px; color:#6b7280;">
    Se não foi você quem pediu, ignore este e-mail. Sua senha continua a mesma até você criar uma nova pelo link acima.
  </p>
<% end %>
