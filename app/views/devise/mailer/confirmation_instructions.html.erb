<%= render layout: "devise/mailer/frame", locals: { preheader: "Confirme seu e-mail para ativar a conta na TR AutoFix." } do %>
  <h1 style="margin:0 0 14px 0; font-size:22px; line-height:1.25;">Confirme seu e-mail</h1>
  <p style="margin:0 0 12px 0;">Olá, <strong><%= @resource.name.presence || @resource.email %></strong>!</p>
  <p style="margin:0 0 4px 0;">
    Obrigado por se cadastrar na TR AutoFix. Para ativar sua conta e comprar com segurança, confirme o seu e-mail:
  </p>
  <%= render "shared/email_button", label: "Confirmar meu e-mail",
                                    url: confirmation_url(@resource, confirmation_token: @token) %>
  <p style="margin:0; font-size:13px; color:#6b7280;">Se você não criou uma conta na TR AutoFix, pode ignorar este e-mail.</p>
<% end %>
