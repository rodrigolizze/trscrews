<%= render layout: "devise/mailer/frame" do %>
  <p style="margin:0 0 12px 0;">Olá <strong><%= @resource.name.presence || @resource.email %></strong>,</p>
  <p style="margin:0 0 12px 0;">A senha da sua conta na TR AutoFix acabou de ser alterada.</p>
  <p style="margin:0; font-size:13px; color:#6b7280;">
    Se não foi você, redefina a senha pelo link "Esqueci minha senha" na página de login e fale com a gente.
  </p>
<% end %>
