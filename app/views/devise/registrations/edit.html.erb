<%# // Tela de edição de conta (Devise) - padronizada com o registrations/new %>
<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">

          <%# // Título e subtítulo %>
          <h1 class="h3 mb-2 text-center">Minha conta</h1>
          <p class="text-muted small text-center mb-4">
            Atualize seus dados. Para alterar a senha, preencha os campos abaixo.
          </p>

          <%# // Erros do Devise %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <%# // Form principal (Devise) %>
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>

            <div class="mb-3">
              <%= f.label :email, "E-mail", class: "form-label" %>
              <%= f.email_field :email,
                    autofocus: true,
                    autocomplete: "email",
                    class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :name, "Nome completo", class: "form-label" %>
              <%= f.text_field :name,
                    class: "form-control",
                    placeholder: "Ex: João Oliveira" %>
            </div>

            <%# // Confirmable: aviso se está aguardando confirmação de e-mail %>
            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div class="alert alert-warning small">
                Estamos aguardando a confirmação do novo e-mail:
                <strong><%= resource.unconfirmed_email %></strong>
              </div>
            <% end %>

            <hr class="my-4">

            <%# // Seção de senha %>
            <h2 class="h6 fw-bold mb-2">Alterar senha</h2>
            <p class="text-muted small mb-3">
              Deixe em branco se você não quiser trocar a senha.
            </p>

            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-center">
                <%= f.label :password, "Nova senha", class: "form-label mb-0" %>
                <% if @minimum_password_length %>
                  <small class="text-muted">
                    Mínimo de <%= @minimum_password_length %> caracteres
                  </small>
                <% end %>
              </div>

              <%= f.password_field :password,
                    autocomplete: "new-password",
                    class: "form-control",
                    placeholder: "Digite uma nova senha (opcional)" %>
            </div>

            <div class="mb-3">
              <%= f.label :password_confirmation, "Confirmar nova senha", class: "form-label" %>
              <%= f.password_field :password_confirmation,
                    autocomplete: "new-password",
                    class: "form-control",
                    placeholder: "Repita a nova senha" %>
            </div>

            <div class="mb-4">
              <%= f.label :current_password, "Senha atual", class: "form-label" %>
              <p class="text-muted small mb-2">
                Precisamos da sua senha atual para confirmar as alterações.
              </p>
              <%= f.password_field :current_password,
                    autocomplete: "current-password",
                    class: "form-control",
                    placeholder: "Digite sua senha atual" %>
            </div>

            <%# // Botões %>
            <div class="d-grid gap-2 mb-2">
              <%= f.submit "Salvar alterações", class: "btn btn-primary btn-lg" %>
            </div>

            <div class="d-grid">
              <%= link_to "Voltar", :back, class: "btn btn-outline-secondary" %>
            </div>

          <% end %>

          <hr class="my-4">

          <%# // Zona de perigo: cancelar conta %>
          <div class="border rounded-3 p-3">
            <h2 class="h6 fw-bold text-danger mb-1">Cancelar conta</h2>
            <p class="text-muted small mb-3">
              Essa ação é permanente e não pode ser desfeita.
            </p>

            <%= button_to "Cancelar minha conta",
                  registration_path(resource_name),
                  method: :delete,
                  data: { confirm: "Tem certeza? Essa ação é permanente.", turbo_confirm: "Tem certeza? Essa ação é permanente." },
                  class: "btn btn-outline-danger w-100" %>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
