<%# // Tela de cadastro de usuário (Devise) %>
<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">

          <%# // Título e subtítulo %>
          <h1 class="h3 mb-2 text-center">Criar conta</h1>
          <p class="text-muted small text-center mb-4">
            Crie sua conta para comprar parafusos online com segurança na TR AutoParts.
          </p>

          <%# // Mostra erros de validação do Devise (partial padrão) %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <%# // Formulário principal do Devise %>
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

            <div class="mb-3">
              <%= f.label :name, "Nome completo", class: "form-label" %>
              <%= f.text_field :name,
                    autofocus: true,
                    class: "form-control",
                    placeholder: "Ex: João Oliveira" %>
            </div>

            <div class="mb-3">
              <%= f.label :email, "E-mail", class: "form-label" %>
              <%= f.email_field :email,
                    class: "form-control",
                    autocomplete: "email",
                    placeholder: "exemplo@gmail.com" %>
            </div>

            <div class="mb-3">
              <%# // Label + dica de tamanho mínimo da senha %>
              <div class="d-flex justify-content-between align-items-center">
                <%= f.label :password, "Senha", class: "form-label mb-0" %>
                <% if @minimum_password_length %>
                  <small class="text-muted">
                    Mínimo de <%= @minimum_password_length %> caracteres
                  </small>
                <% end %>
              </div>

              <%= f.password_field :password,
                    class: "form-control",
                    autocomplete: "new-password",
                    placeholder: "Digite uma senha segura" %>
            </div>

            <div class="mb-4">
              <%= f.label :password_confirmation, "Confirme a senha", class: "form-label" %>
              <%= f.password_field :password_confirmation,
                    class: "form-control",
                    autocomplete: "new-password",
                    placeholder: "Repita a senha" %>
            </div>

            <%# // Botão principal %>
            <div class="d-grid gap-2 mb-3">
              <%= f.submit "Criar conta",
                    class: "btn btn-primary btn-lg" %>
            </div>

          <% end %>

          <%# // Link para login, caso a pessoa já tenha conta %>
          <p class="text-center text-muted small mb-0">
            Já tem conta?
            <%= link_to "Entrar", new_session_path(resource_name), class: "fw-semibold" %>
          </p>

        </div>
      </div>
    </div>
  </div>
</div>
