<%# // Tela de login de usuário (Devise) %>
<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">

          <%# // Título e subtítulo %>
          <h1 class="h3 mb-2 text-center">Entrar</h1>
          <p class="text-muted small text-center mb-4">
            Acesse sua conta TR AutoParts para acompanhar pedidos e finalizar suas compras.
          </p>

          <%# // Mensagens de erro do Devise (caso login falhe) %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <%# // Formulário de login %>
          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

            <div class="mb-3">
              <%= f.label :email, "E-mail", class: "form-label" %>
              <%= f.email_field :email,
                    autofocus: true,
                    class: "form-control",
                    autocomplete: "email",
                    placeholder: "voce@exemplo.com" %>
            </div>

            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-center">
                <%= f.label :password, "Senha", class: "form-label mb-0" %>
                <%# // Link para “esqueci minha senha” (Devise padrão) %>
                <%= link_to "Esqueci minha senha",
                            new_password_path(resource_name),
                            class: "small text-decoration-none" %>
              </div>

              <%= f.password_field :password,
                    class: "form-control",
                    autocomplete: "current-password",
                    placeholder: "Digite sua senha" %>
            </div>

            <%# // Lembrar-me (remember_me) se estiver habilitado %>
            <% if devise_mapping.rememberable? %>
              <div class="form-check mb-4">
                <%= f.check_box :remember_me, class: "form-check-input" %>
                <%= f.label :remember_me, "Lembrar de mim neste dispositivo", class: "form-check-label" %>
              </div>
            <% end %>

            <div class="d-grid gap-2 mb-3">
              <%= f.submit "Entrar",
                    class: "btn btn-primary btn-lg" %>
            </div>

          <% end %>

          <%# // Link para criar conta %>
          <p class="text-center text-muted small mb-0">
            Ainda não tem conta?
            <%= link_to "Criar conta", new_registration_path(resource_name), class: "fw-semibold" %>
          </p>

        </div>
      </div>
    </div>
  </div>
</div>
