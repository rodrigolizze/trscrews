<%# // Carrinho — redesign direção D. Itens em cartões (não em tabela) para caber no
    // celular sem rolagem lateral. Os formulários são os mesmos de antes:
    // set_cart (PATCH quantity), remove_cart (DELETE), clear_cart (DELETE) e o link
    // de checkout — nada mudou no fluxo, só a apresentação.
    // Original em Escritorio-IA/projetos/01-ecommerce/redesign/backup-original/. %>
<div class="container py-4 py-lg-5 cart-d">
  <h1 class="cart-title">Seu carrinho</h1>

  <% if @lines.present? %>
    <div class="cart-grid">
      <div class="cart-items">
        <% @lines.each do |line| %>
          <% screw = line[:screw]; qty = line[:qty]; line_total = line[:line_total] %>
          <article class="cart-item">
            <%= link_to screw_path(screw), class: "cart-item__img", tabindex: -1, aria: { hidden: true } do %>
              <% if screw.images.attached? %>
                <%= image_tag screw.images.first.variant(resize_to_limit: [160, 160]), alt: "" %>
              <% else %>
                <svg width="36" height="36" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 8h24l6 8-6 8H20l-6-8z"/><path d="M26 24v32h12V24"/><path d="M26 30l12 3M26 36l12 3M26 42l12 3M26 48l12 3"/></svg>
              <% end %>
            <% end %>

            <div class="cart-item__body">
              <h2 class="cart-item__title"><%= link_to screw.description, screw_path(screw) %></h2>
              <p class="cart-item__meta"><%= [screw.thread, screw.surface_treatment].compact_blank.join(" · ") %></p>
              <p class="cart-item__unit"><%= format_price(screw.price) %> / un.</p>

              <div class="cart-item__actions">
                <%= form_with url: set_cart_path(screw_id: screw.id), method: :patch, local: true, class: "cart-qty" do %>
                  <label for="qty-<%= screw.id %>" class="visually-hidden">Quantidade</label>
                  <%= number_field_tag :quantity, qty, id: "qty-#{screw.id}", class: "form-control", min: 0, inputmode: "numeric" %>
                  <%= submit_tag "Atualizar", class: "btn btn-outline-secondary btn-sm", name: nil %>
                <% end %>
                <%= button_to "Remover",
                              remove_cart_path(screw_id: screw.id),
                              method: :delete,
                              form: { data: { turbo_confirm: "Remover item?" } },
                              class: "btn btn-sm btn-outline-danger" %>
              </div>
            </div>

            <div class="cart-item__total"><%= format_price(line_total) %></div>
          </article>
        <% end %>

        <div class="cart-secondary">
          <%= link_to "Continuar comprando", screws_path, class: "btn btn-outline-secondary" %>
          <%= button_to "Esvaziar carrinho", clear_cart_path, method: :delete,
                        form: { data: { turbo_confirm: "Esvaziar carrinho?" } },
                        class: "btn btn-outline-danger" %>
        </div>
      </div>

      <aside class="cart-summary" aria-label="Resumo do pedido">
        <% free_limit = Rails.configuration.x.shipping.free_limit %>
        <% remaining  = [free_limit - @subtotal.to_d, 0.to_d].max %>
        <% percent    = [((@subtotal.to_d / free_limit) * 100).to_i, 100].min %>

        <% if remaining > 0 %>
          <p class="cart-free">Faltam <strong><%= format_price(remaining) %></strong> para frete grátis</p>
          <div class="progress mb-3" role="progressbar" aria-label="Progresso para frete grátis"
               aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: <%= percent %>%;"></div>
          </div>
        <% else %>
          <div class="alert alert-success py-2 mb-3">Você ganhou <strong>frete grátis</strong>!</div>
        <% end %>

        <dl class="cart-totals">
          <div><dt>Subtotal</dt><dd><%= format_price(@subtotal) %></dd></div>
          <div><dt>Frete</dt><dd><%= format_price(@shipping) %></dd></div>
          <div class="cart-totals__grand"><dt>Total</dt><dd><%= format_price(@total) %></dd></div>
        </dl>

        <%= link_to "Finalizar compra", checkout_path, class: "btn btn-yellow btn-lg w-100" %>
      </aside>
    </div>
  <% else %>
    <div class="cart-empty">
      <p class="cart-empty__title">Seu carrinho está vazio.</p>
      <p>Encontre o parafuso certo pela medida ou pelo seu carro.</p>
      <%= link_to "Ver produtos", screws_path, class: "btn btn-yellow" %>
    </div>
  <% end %>
</div>
