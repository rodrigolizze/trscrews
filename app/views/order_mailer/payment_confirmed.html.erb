<% number = @order.order_number || "##{@order.id}" %>
<% content_for :preheader, "Pagamento do pedido #{number} aprovado. Postagem em até 1 dia útil." %>
<p style="margin:0 0 4px 0; font-size:12px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:#9a7600;">
  Pedido <%= number %>
</p>
<h1 style="margin:0 0 14px 0; font-size:24px; line-height:1.2;">Pagamento confirmado</h1>

<p style="margin:0 0 4px 0;">
  Olá, <strong><%= @order.customer_name %></strong>! Recebemos o seu pagamento. Agora é com a gente:
  o pedido é postado em até <strong>1 dia útil</strong> no endereço abaixo.
</p>

<%= render "shared/email_button", label: "Ver meus pedidos", url: my_orders_url %>

<h2 style="margin:8px 0 8px 0; font-size:14px; text-transform:uppercase; letter-spacing:0.5px;">Resumo</h2>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-size:14px;">
  <% @order.order_items.includes(:screw).each do |item| %>
    <tr>
      <td style="padding:8px 0; border-bottom:1px solid #e6e8eb;">
        <strong><%= item.screw.description %></strong><br />
        <span style="color:#6b7280;"><%= [item.screw.thread, item.screw.surface_treatment].compact_blank.join(" · ") %></span>
      </td>
      <td align="right" style="padding:8px 0 8px 12px; border-bottom:1px solid #e6e8eb; white-space:nowrap;">
        <%= item.quantity %> × <%= format_price(item.unit_price) %>
      </td>
      <td align="right" style="padding:8px 0 8px 12px; border-bottom:1px solid #e6e8eb; white-space:nowrap;">
        <strong><%= format_price(item.line_total) %></strong>
      </td>
    </tr>
  <% end %>
  <tr>
    <td colspan="2" align="right" style="padding:8px 0 2px 0; color:#6b7280;">Subtotal</td>
    <td align="right" style="padding:8px 0 2px 12px; white-space:nowrap;"><%= format_price(@order.items_subtotal) %></td>
  </tr>
  <tr>
    <td colspan="2" align="right" style="padding:2px 0; color:#6b7280;">Frete</td>
    <td align="right" style="padding:2px 0 2px 12px; white-space:nowrap;">
      <%= @order.shipping_amount.to_d.zero? ? "Grátis" : format_price(@order.shipping_amount) %>
    </td>
  </tr>
  <tr>
    <td colspan="2" align="right" style="padding:6px 0; font-size:16px;"><strong>Total</strong></td>
    <td align="right" style="padding:6px 0 6px 12px; font-size:16px; white-space:nowrap;"><strong><%= format_price(@order.total_amount) %></strong></td>
  </tr>
</table>

<h2 style="margin:22px 0 6px 0; font-size:14px; text-transform:uppercase; letter-spacing:0.5px;">Entrega</h2>
<p style="margin:0; font-size:14px; color:#374151;">
  <%= @order.customer_name %><br />
  <%= @order.street %>, <%= @order.number %><%= " – #{@order.complement}" if @order.complement.present? %><br />
  <%= @order.district %> · <%= @order.city %> – <%= @order.state %><br />
  CEP <%= @order.cep %>
</p>
