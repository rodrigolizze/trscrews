<%# // Página do pedido logo após "Finalizar pedido" e retorno da Stripe — redesign D.
    // Com pay=1 o botão de pagamento se envia sozinho (ver _stripe_pay_button). %>
<%# // confirming: voltou da Stripe (paid=1) mas o aviso de pagamento ainda não chegou —
    // normal no Pix (o dinheiro cai depois) e por alguns segundos no cartão. %>
<% confirming = params[:paid].present? && !@order.paid? && !@order.payment_expired? %>
<% status_label, status_class =
     if @order.paid?             then ["Pago", "ok"]
     elsif @order.payment_expired? then ["Expirado", "off"]
     elsif confirming             then ["Em confirmação", "wait"]
     else                             ["Aguardando pagamento", "wait"]
     end %>

<div class="container py-4 py-lg-5 ty-d">
  <div class="ty-head">
    <div>
      <p class="hd-eyebrow ty-eyebrow">Pedido <%= @order.order_number || "##{@order.id}" %></p>
      <h1 class="ty-title">
        <%= if @order.paid? then "Obrigado pela compra!"
            elsif @order.payment_expired? then "Pedido expirado"
            elsif confirming then "Pagamento em confirmação"
            else "Falta só o pagamento"
            end %>
      </h1>
    </div>
    <span class="ty-status ty-status--<%= status_class %>"><%= status_label %></span>
  </div>

  <div class="ty-grid">
    <section class="ty-box">
      <% if @order.paid? %>
        <p>Obrigado, <strong><%= @order.customer_name %></strong>. Enviamos a confirmação para <strong><%= @order.customer_email %></strong>.</p>
      <% end %>
      <%= render "stripe_pay_button", confirming: confirming %>
    </section>

    <section class="ty-box">
      <h2 class="co-summary__title">Resumo</h2>
      <dl class="cart-totals mb-0">
        <div><dt>Itens</dt><dd><%= format_price(@order.items_subtotal) %></dd></div>
        <div><dt>Frete</dt><dd><%= format_price(@order.shipping_amount) %></dd></div>
        <div class="cart-totals__grand"><dt>Total</dt><dd><%= format_price(@order.total_amount) %></dd></div>
      </dl>
    </section>
  </div>

  <div class="ty-actions">
    <% if defined?(user_signed_in?) && user_signed_in? %>
      <%= link_to "Ver detalhes do pedido", @order, class: "btn btn-outline-secondary" %>
      <%= link_to "Meus pedidos", my_orders_path, class: "btn btn-outline-secondary" %>
    <% else %>
      <%= link_to "Entrar para acompanhar seus pedidos", new_user_session_path, class: "btn btn-outline-secondary" %>
    <% end %>
    <%= link_to "Voltar ao catálogo", screws_path, class: "btn btn-outline-secondary" %>
  </div>
</div>
