<!-- app/views/orders/thank_you.html.erb -->

<div class="container py-4 mb-5">
  <%# ------------------------------------------------------------ %>
  <%# Cabeçalho igual ao da página de detalhes do pedido          %>
  <%# ------------------------------------------------------------ %>
  <% status_label, status_class =
      if @order.paid?
        ["Pago", "success"]       # // badge verde
      else
        ["Pendente", "warning"]   # // badge amarela
      end %>

  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-3">
    <div>
      <h1 class="h3 mb-1">
        Pedido <%= @order.order_number || "##{@order.id}" %>
      </h1>
      <div class="small text-muted">
        Nº interno: #<%= @order.id %>
      </div>
    </div>

    <span class="badge bg-<%= status_class %> px-3 py-2 fs-6 mt-2 mt-md-0">
      <%= status_label %>
    </span>
  </div>

  <%# ------------------------------------------------------------ %>
  <%# Mensagem de “pedido recebido”                               %>
  <%# ------------------------------------------------------------ %>
  <div class="alert alert-success">
    <h2 class="h5 mb-1">Pedido recebido!</h2>
    <p class="mb-0">
      Obrigado, <strong><%= @order.customer_name %></strong>.
      Enviamos os detalhes do pedido para
      <strong><%= @order.customer_email %></strong>.
    </p>
  </div>

  <%# ------------------------------------------------------------ %>
  <%# Resumo rápido do pedido                                     %>
  <%# ------------------------------------------------------------ %>
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h2 class="h5 mb-3">Resumo do pedido</h2>

      <p class="mb-1">
        Número do pedido:
        <strong><%= @order.order_number || "##{@order.id}" %></strong>
      </p>

      <p class="mb-1">
        Situação do pagamento:
      </p>

      <%# // Bloco de status do pagamento (fora da tag <p>) %>
      <% if @order.paid? %>
        <div class="alert alert-success mb-4">
          Pagamento recebido! Obrigado pela sua compra.
        </div>
      <% else %>
        <div class="alert alert-info d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
          <div>
            <strong>Próximo passo:</strong>
            <span>faça o pagamento para confirmar seu pedido.</span>
          </div>

          <div>
            <%# // Usa o mesmo botão de pagamento da página show %>
            <%= render "stripe_pay_button" %>
          </div>
        </div>
      <% end %>

      <%# -------------------------------------------------------- %>
      <%# Ações sugeridas (links)                                 %>
      <%# -------------------------------------------------------- %>
      <% if defined?(user_signed_in?) && user_signed_in? %>
        <div class="mb-3">
          <%= link_to "Ver detalhes do pedido", @order, class: "btn btn-primary me-2" %>
          <%= link_to "Ver meus pedidos", my_orders_path, class: "btn btn-outline-secondary" %>
        </div>
      <% else %>
        <div class="mb-3">
          <%= link_to "Criar conta ou entrar para acompanhar seus pedidos",
                      new_user_session_path,
                      class: "btn btn-primary" %>
        </div>
      <% end %>

      <div>
        <%= link_to "Voltar ao catálogo", screws_path, class: "btn btn-outline-secondary" %>
      </div>
    </div> <!-- /.card-body -->
  </div>   <!-- /.card -->
</div>     <!-- /.container -->
