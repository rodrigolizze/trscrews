<!-- app/views/orders/new.html.erb -->
<div class="container py-4">
  <h1 class="co-title">Finalizar compra</h1>

  <div class="row g-4">
    <!-- Left column: items summary -->
    <div class="col-lg-7">
      <%# // Resumo em lista (não em tabela) para caber no celular. Só apresentação:
          // os valores vêm dos mesmos @lines/@subtotal/@shipping/@total. %>
      <div class="co-summary">
        <h2 class="co-summary__title">Resumo do pedido</h2>
        <ul class="co-lines">
          <% @lines.each do |line| %>
            <% screw = line[:screw] %>
            <li class="co-line">
              <div class="co-line__img" aria-hidden="true">
                <% if screw.images.attached? %>
                  <%= image_tag screw.images.first.variant(resize_to_limit: [120,120]), alt: "" %>
                <% else %>
                  <svg width="28" height="28" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 8h24l6 8-6 8H20l-6-8z"/><path d="M26 24v32h12V24"/><path d="M26 30l12 3M26 36l12 3M26 42l12 3M26 48l12 3"/></svg>
                <% end %>
              </div>
              <div class="co-line__body">
                <strong><%= screw.description %></strong>
                <small><%= line[:qty] %> × <%= format_price(line[:unit_price]) %></small>
              </div>
              <div class="co-line__total"><%= format_price(line[:line_total]) %></div>
            </li>
          <% end %>
        </ul>
        <dl class="cart-totals">
          <div><dt>Subtotal</dt><dd><%= format_price(@subtotal) %></dd></div>
          <div><dt>Frete</dt><dd><%= format_price(@shipping) %></dd></div>
          <div class="cart-totals__grand"><dt>Total</dt><dd><%= format_price(@total) %></dd></div>
        </dl>
      </div>
      <%= link_to "Voltar ao carrinho", cart_path, class: "btn btn-outline-secondary mt-3" %>
    </div>

    <!-- Right column: address picker + form -->
    <div class="col-lg-5">
      <% if defined?(user_signed_in?) && user_signed_in? %>
        <div class="card shadow-sm mb-3">
          <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <h6 class="mb-0">Escolher endereço de entrega</h6>
              <%= link_to "Novo endereço", new_shipping_address_path(return_to: "checkout"), class: "btn btn-sm btn-outline-secondary" %>
            </div>

            <% if @addresses.present? %>
              <div class="list-group">
                <% @addresses.each do |a| %>
                  <% is_active =
                      (params[:address_id].present? && params[:address_id].to_i == a.id) ||
                      (!params[:address_id].present? && (a.is_default? || a == @addresses.first)) %>

                  <div class="list-group-item d-flex justify-content-between align-items-start <%= 'active' if is_active %>">
                    <div class="me-3">
                      <strong><%= a.recipient_name.presence || current_user.name || "Destinatário" %></strong><br>
                      <small class="text-muted">
                        <%= a.street %>, <%= a.number %><%= a.complement.present? ? " — #{a.complement}" : "" %><br>
                        <%= a.district %> — <%= a.city %>/<%= a.state %><br>
                        CEP: <%= a.cep %>
                      </small>
                    </div>
                    <div class="ms-auto d-flex gap-2">
                      <%= link_to "Editar",
                                  edit_shipping_address_path(a, return_to: "checkout"),  # // send return_to flag
                                  class: "btn btn-sm btn-outline-secondary" %>
                      <%= link_to "Usar este",
                                  checkout_path(address_id: a.id),
                                  class: "btn btn-sm btn-outline-primary",
                                  data: { turbo: false } %>  <%# // keep full reload so the form is prefilled %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="alert alert-info mb-0">
                Você ainda não cadastrou endereços.
                <%= link_to "Adicionar agora", new_shipping_address_path, class: "alert-link" %>.
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="card-title mb-3">Seus dados</h5>

          <% if @order.errors.any? %>
            <div class="alert alert-danger">
              <strong><%= pluralize(@order.errors.count, "erro") %> ao salvar:</strong>
              <ul class="mb-0">
                <% @order.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= form_with model: @order, url: orders_path, local: true do |f| %>
            <div class="mb-3">
              <%= f.label :customer_name, "Nome completo", class: "form-label" %>
              <%= f.text_field :customer_name, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :customer_email, "Email", class: "form-label" %>
              <%= f.email_field :customer_email, class: "form-control", required: true %>
            </div>

            <hr class="my-4">
            <h6 class="mb-3">Endereço de entrega</h6>

            <div data-controller="cep">
              <div class="mb-3">
                <%= f.label :cep, "CEP", class: "form-label" %>
                <%= f.text_field :cep,
                                  class: "form-control",
                                  placeholder: "12345-678",
                                  required: true,
                                  maxlength: 9,
                                  inputmode: "numeric",
                                  autocomplete: "postal-code",
                                  pattern: "\\d{5}-\\d{3}",
                                  data: {
                                    cep_target: "cep",
                                    action: "input->cep#mask input->cep#debouncedLookup blur->cep#lookup"
                                  } %>
                <div data-cep-target="feedback" class="small text-muted mt-1"></div>
              </div>

              <div class="mb-3">
                <%= f.label :street, "Rua", class: "form-label" %>
                <%= f.text_field :street, class: "form-control", required: true, data: { cep_target: "street" } %>
              </div>

              <div class="row g-3">
                <div class="col-6">
                  <%= f.label :number, "Número", class: "form-label" %>
                  <%= f.text_field :number, class: "form-control", required: true %>
                </div>
                <div class="col-6">
                  <%= f.label :complement, "Complemento", class: "form-label" %>
                  <%= f.text_field :complement, class: "form-control" %>
                </div>
              </div>

              <div class="row g-3 mt-1">
                <div class="col-6">
                  <%= f.label :district, "Bairro", class: "form-label" %>
                  <%= f.text_field :district, class: "form-control", required: true, data: { cep_target: "district" } %>
                </div>
                <div class="col-6">
                  <%= f.label :city, "Cidade", class: "form-label" %>
                  <%= f.text_field :city, class: "form-control", required: true, data: { cep_target: "city" } %>
                </div>
              </div>

              <div class="mb-3 mt-1">
                <%= f.label :state, "UF", class: "form-label" %>
                <%# // UF só para leitura: o servidor define pelo CEP (CepMatchesState).
                    // name: nil = não é enviada no formulário; o ViaCEP só a exibe. %>
                <%= f.text_field :state, name: nil, readonly: true, tabindex: -1,
                      class: "form-control", placeholder: "Pelo CEP",
                      aria: { describedby: "order-state-hint" }, data: { cep_target: "state" } %>
                <div id="order-state-hint" class="form-text">Preenchida automaticamente pelo CEP.</div>
              </div>
            </div>

            <%# // Progress bar de frete grátis (usa @subtotal) %>
            <% free_limit = Rails.configuration.x.shipping.free_limit %>   <%# // from initializer %>
            <% remaining  = [free_limit - @subtotal.to_d, 0.to_d].max %>
            <% percent    = [((@subtotal.to_d / free_limit) * 100).to_i, 100].min %>

            <% if remaining > 0 %>
              <div class="small mb-1">Faltam <strong><%= format_price(remaining) %></strong> para frete grátis</div>
              <div class="progress mb-3">
                <div class="progress-bar"
                    role="progressbar"
                    style="width: <%= percent %>%;"
                    aria-valuenow="<%= percent %>"
                    aria-valuemin="0"
                    aria-valuemax="100">
                  <%= percent %>%
                </div>
              </div>
            <% else %>
              <div class="alert alert-success py-2 mb-3">Você ganhou <strong>frete grátis</strong>!</div>
            <% end %>

            <div class="border-top pt-3 mt-3 d-flex align-items-center justify-content-between">
              <div>
                <div class="small text-muted">Subtotal</div>
                <div><%= format_price(@subtotal) %></div>
              </div>
              <div>
                <div class="small text-muted">
                Frete<% if @shipping_uf.present? %> (<%= @shipping_uf %> – <%= @shipping_region.to_s.humanize %>)<% end %></div>
                <div><%= format_price(@shipping) %></div>
              </div>
              <div>
                <div class="small text-muted">Total</div>
                <div class="h5 mb-0"><%= format_price(@total) %></div>
              </div>
            </div>

            <p class="small text-muted mb-2">
              Ao confirmar, você concorda com os <%= link_to "Termos de uso", terms_of_use_path, target: "_blank" %>
              e a <%= link_to "Política de privacidade", privacy_policy_path, target: "_blank" %>.
              Desistiu? Você tem 7 dias após o recebimento — veja <%= link_to "trocas e devoluções", returns_policy_path, target: "_blank" %>.
            </p>
            <div class="d-grid">
              <%= f.submit "Confirmar pedido", class: "btn btn-yellow" %>
            </div>
          <% end %>

          <p class="text-muted small mt-3 mb-0">
            * Após a confirmação do pedido, verificar o e-mail recebido.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
